{
  "name": "space-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.offline.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && playwright test -c playwright.production.config.ts",
    "measure:performance": "npm run build && node scripts/measure-performance.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pannellum": "2.5.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
